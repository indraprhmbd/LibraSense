FROM docker.io/library/alpine:3.22

RUN apk add --no-cache ca-certificates tzdata \
 && adduser -D -H -u 10001 -s /sbin/nologin librasense

WORKDIR /app

COPY dist/librasense /app/librasense
RUN chmod 0755 /app/librasense && mkdir -p /data && chown 10001:10001 /data

# CA certificates are required: the server fetches Cloudflare Access JWKS over HTTPS.
USER 10001:10001

EXPOSE 8097

ENTRYPOINT ["/app/librasense"]
